# Neon Console의 Connect에서 복사한 pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# 브라우저에서 CRM을 열 때 입력할 32자 이상의 임의 연결키
CRM_ACCESS_KEY=replace-with-a-long-random-secret

# 선택: 기본 관리자 코드를 바꿀 때만 주석을 해제하고 8자 이상의 새 코드를 입력
# CRM_ADMIN_CODE=replace-with-a-private-admin-code

# 같은 DB를 여러 CRM이 공유할 때 데이터를 구분하는 값
CRM_WORKSPACE_ID=tiniko

# 로컬 실행용. Render는 PORT를 자동으로 제공합니다.
PORT=3000
